# Token bot dari @BotFather (wajib)
BOT_TOKEN=

# User ID Telegram admin, pisahkan dengan koma. Lihat via @userinfobot
ADMIN_IDS=

# public = semua orang boleh pakai, whitelist = hanya WHITELIST_IDS (+admin)
ACCESS_MODE=public
WHITELIST_IDS=

# Batas unduhan sukses per user per hari (default, bisa diubah admin via /limit)
DAILY_LIMIT=10

# Anti-spam / rate limit per user
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX_REQUESTS=5

# Batas durasi konten maksimal dalam detik (default 3600 = 1 jam)
MAX_DURATION_SEC=3600

# Resolusi maksimum yang ditawarkan (mis. 720 untuk hemat bandwidth)
MAX_RESOLUTION=1080

# Batas upload Bot API standar = 50 MB.
# Kalau pakai Local Bot API Server, boleh sampai 2000 (2 GB).
MAX_UPLOAD_MB=50

# Jumlah unduhan paralel
CONCURRENCY=2

# Timeout total per job (detik)
QUEUE_TIMEOUT_SEC=900

# Opsional: file cookies.txt / direktori pool untuk konten yang butuh login
# Bisa path file tunggal, daftar pisah koma, atau folder berisi *.txt
# YOUTUBE_COOKIES_TXT=/path/cookies.txt
# FACEBOOK_COOKIES_TXT=/path/fb_cookies.txt
# INSTAGRAM_COOKIES_TXT=/path/ig_cookies.txt
# COOKIES_DIR=./data/cookies

# Opsional: rotasi proxy (HTTP/SOCKS5). Pisahkan dengan koma atau path ke file .txt (1 proxy per baris)
# PROXIES=http://user:pass@ip1:port,socks5://ip2:port
# PROXY_FILE=/path/to/proxies.txt

# Opsional: path binari khusus
# YTDLP_PATH=yt-dlp
# FFMPEG_PATH=ffmpeg
